{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deadlock-contracts.online/schemas/bootstrap.v2.schema.json",
  "type": "object",
  "required": ["api_version", "schema_version", "server_time", "desktop_features", "boards", "active_cases", "history"],
  "properties": {
    "api_version": {"const": "desktop.v1"},
    "schema_version": {"const": 2},
    "server_time": {"type": "string", "minLength": 1},
    "desktop_features": {"type": "array", "items": {"type": "string"}},
    "boards": {
      "type": "array",
      "items": {"$ref": "#/$defs/board"}
    },
    "active_cases": {
      "type": "array",
      "items": {"$ref": "#/$defs/activeCase"}
    },
    "history": {
      "type": "object",
      "required": ["items"],
      "properties": {"items": {"type": "array"}},
      "additionalProperties": true
    },
    "announcements": {
      "type": "array",
      "maxItems": 5,
      "items": {"$ref": "#/$defs/announcement"}
    },
    "overlay_announcements": {
      "type": "array",
      "maxItems": 5,
      "items": {"$ref": "#/$defs/announcement"}
    }
  },
  "$defs": {
    "announcement": {
      "type": "object",
      "required": ["id", "revision", "severity", "presentation", "effect", "dismiss_policy", "priority", "title", "body", "starts_at", "ends_at"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 64},
        "revision": {"type": "integer", "minimum": 1},
        "phase": {"const": "ACTIVE"},
        "severity": {"enum": ["INFO", "SUCCESS", "WARNING", "MAINTENANCE", "CRITICAL", "EVENT"]},
        "presentation": {"enum": ["BANNER", "TOAST", "MODAL"]},
        "effect": {"enum": ["NONE", "FADE_SLIDE", "STAMP_IN", "SOFT_GLOW", "SCANLINE_ONCE", "CONFETTI_ONCE"]},
        "dismiss_policy": {"enum": ["DISMISSIBLE", "ACK_REQUIRED", "NON_DISMISSIBLE"]},
        "priority": {"type": "integer", "minimum": 0, "maximum": 100},
        "title": {"type": "string", "minLength": 1, "maxLength": 160},
        "body": {"type": "string", "minLength": 1, "maxLength": 2000},
        "cta": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["label", "url"],
              "properties": {
                "label": {"type": "string", "minLength": 1, "maxLength": 64},
                "url": {"type": "string", "minLength": 1, "maxLength": 500}
              },
              "additionalProperties": false
            }
          ]
        },
        "starts_at": {"type": "string", "minLength": 1},
        "ends_at": {"type": "string", "minLength": 1},
        "show_countdown": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "condition": {
      "type": "object",
      "required": ["metric", "operator", "target"],
      "properties": {
        "metric": {"type": "string", "minLength": 1},
        "operator": {"enum": ["gte", "lte", "eq"]},
        "target": {"type": "number", "minimum": 0}
      },
      "additionalProperties": true
    },
    "option": {
      "type": "object",
      "required": ["id", "conditions", "reward_xp", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title_key": {"type": ["string", "null"]},
        "title_i18n": {"type": ["object", "null"]},
        "flavor_i18n": {"type": ["object", "null"]},
        "game_match_mode": {"enum": ["STANDARD", "RANKED", "STREET_BRAWL"]},
        "conditions": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/condition"}},
        "reward_xp": {"type": "integer", "minimum": 0},
        "status": {"type": "string", "minLength": 1}
      },
      "anyOf": [{"required": ["title_key"]}, {"required": ["title_i18n"]}],
      "additionalProperties": true
    },
    "board": {
      "type": "object",
      "required": ["id", "game_match_mode", "options"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "game_match_mode": {"enum": ["STANDARD", "RANKED", "STREET_BRAWL"]},
        "options": {"type": "array", "items": {"$ref": "#/$defs/option"}}
      },
      "additionalProperties": true
    },
    "activeCase": {
      "type": "object",
      "required": ["game_match_mode"],
      "properties": {
        "game_match_mode": {"enum": ["STANDARD", "RANKED", "STREET_BRAWL"]},
        "options": {"type": "array", "items": {"$ref": "#/$defs/option"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
