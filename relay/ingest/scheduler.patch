+#[derive(Clone)]
+pub(super) struct Candidate {
+    pub(super) task: Task,
+    pub(super) match_id: Option<u64>,
+    score: i64,
+    urgency: bool,
+    recent_completion: bool,
+    age: i64,
+}
+
+impl Candidate {
+    pub(super) fn new(task: Task, match_id: Option<u64>, state: &State, now: i64) -> Self {
+        let age = (now - task.waiting()).max(0);
+        let activity = if match_id.is_some() {
+            60
+        } else {
+            state
+                .people
+                .get(&task.account())
+                .map_or(0, |person| person.bonus(&task, now))
+        };
+        let mut score = 100 + activity + (10 * (age / HOUR)).min(120);
+        if task.streamer {
+            score += 40;
+        }
+        if match_id.is_none() && state.history_empty.contains(&task.account()) {
+            score -= 30;
+        }
+        let urgency = match_id.is_some() || activity >= 40 || (!task.streamer && age >= 6 * HOUR);
+        Self {
+            task,
+            match_id,
+            score,
+            urgency,
+            recent_completion: match_id.is_none() && activity >= 40,
+            age,
+        }
+    }
+
+    pub(super) const fn kind(&self) -> Operation {
+        if self.match_id.is_some() {
+            Operation::Metadata
+        } else {
+            Operation::History
+        }
+    }
+
+    fn cooldown_until(&self, state: &State, now: i64) -> Option<i64> {
+        let after = match self.match_id {
+            Some(id) => state.metadata_after.get(&id),
+            None => state.history_after.get(&self.task.account()),
+        };
+        after.copied().filter(|&until| until > now)
+    }
+
+    pub(super) const fn decision(&self, reason: &'static str) -> Decision {
+        Decision {
+            operation: self.kind(),
+            streamer: self.task.streamer,
+            score: self.score,
+            streamer_bonus: if self.task.streamer { 40 } else { 0 },
+            wait_seconds: self.age,
+            reason,
+            next_request_at: None,
+        }
+    }
+}
+
+#[derive(Clone, Serialize)]
+pub(super) struct Decision {
+    operation: Operation,
+    streamer: bool,
+    score: i64,
+    streamer_bonus: i64,
+    wait_seconds: i64,
+    reason: &'static str,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    next_request_at: Option<i64>,
+}
+
+impl Decision {
+    pub(super) fn scheduled(
+        mut self,
+        budget: &Budget,
+        candidate: &Candidate,
+        state: &State,
+        now: i64,
+    ) -> Self {
+        self.next_request_at = match self.reason {
+            "quota" | "paced" | "rate_limited" | "cooldown" | "reserve" => [
+                budget.next_request_at,
+                candidate.cooldown_until(state, now),
+                (candidate.kind() == Operation::History)
+                    .then(|| {
+                        candidate.task.locked_at.timestamp()
+                            + candidate.task.game_mode.likely_duration()
+                    })
+                    .filter(|at| *at > now),
+            ]
+            .into_iter()
+            .flatten()
+            .max(),
+            _ => None,
+        };
+        self
+    }
+
+    pub(super) const fn score(&self) -> i64 {
+        self.score
+    }
+
+    pub(super) fn selected(&self) -> bool {
+        self.reason == "selected"
+    }
+}
+
+#[derive(Clone, Serialize)]
+pub(super) struct Budget {
+    used: usize,
+    limit: usize,
+    remaining: usize,
+    reserve: usize,
+    next_release_at: Option<i64>,
+    next_request_at: Option<i64>,
+    rate_limited_until: Option<i64>,
+    #[serde(skip)]
+    allow_urgent_at: Option<i64>,
+}
+
+impl Budget {
+    pub(super) fn new(
+        hits: &[i64],
+        limit: usize,
+        kind: Operation,
+        state: &State,
+        now: i64,
+    ) -> Self {
+        let mut recent: Vec<_> = hits.iter().copied().filter(|&at| at > now - DAY).collect();
+        recent.sort_unstable();
+        let used = recent.len();
+        let held = limit / 5;
+        let remaining = limit.saturating_sub(used);
+        let min_interval = match kind {
+            Operation::History => HOUR,
+            Operation::Metadata => HOUR / 2,
+        };
+        let interval =
+            (DAY / i64::try_from(limit.saturating_sub(held).max(1)).unwrap_or(1)).max(min_interval);
+        let rate_limited_until = state.usage(kind).rate_limited_until.filter(|&at| at > now);
+        let next_release_at = recent.first().map(|at| at + DAY);
+        let next_capacity_at = if remaining == 0 && limit > 0 {
+            recent.get(used - limit).map(|at| at + DAY)
+        } else {
+            None
+        };
+        let next_interval = recent.last().map(|at| at + interval);
+        // An observed end to a continuous session is useful at the next safe history slot.
+        let allow_urgent_at = recent.last().map(|at| at + min_interval);
+        let next_request_at = [rate_limited_until, next_interval, next_capacity_at]
+            .into_iter()
+            .flatten()
+            .max()
+            .filter(|&at| at > now);
+        Self {
+            used,
+            limit,
+            remaining,
+            reserve: held.min(remaining),
+            next_release_at,
+            next_request_at,
+            rate_limited_until,
+            allow_urgent_at,
+        }
+    }
+
+    pub(super) fn legacy(
+        hits: &[i64],
+        limit: usize,
+        kind: Operation,
+        state: &State,
+        now: i64,
+    ) -> Self {
+        let mut budget = Self::new(hits, limit, kind, state, now);
+        budget.reserve = 0;
+        budget.next_request_at = budget.rate_limited_until.or({
+            if budget.remaining == 0 && limit > 0 {
+                budget.next_release_at
+            } else {
+                None
+            }
+        });
+        budget
+    }
+
+    pub(super) fn exhausted(&self) -> bool {
+        self.remaining == 0 || self.rate_limited_until.is_some()
+    }
+
+    pub(super) fn reason(
+        &self,
+        candidate: &Candidate,
+        state: &State,
+        now: i64,
+    ) -> Option<&'static str> {
+        if self.rate_limited_until.is_some() {
+            return Some("rate_limited");
+        }
+        if self.remaining == 0 {
+            return Some("quota");
+        }
+        if candidate.kind() == Operation::History
+            && candidate.task.locked_at.timestamp() + candidate.task.game_mode.likely_duration()
+                > now
+        {
+            return Some("paced");
+        }
+        if candidate.cooldown_until(state, now).is_some() {
+            return Some("cooldown");
+        }
+        if self.remaining <= self.reserve && !candidate.urgency {
+            return Some("reserve");
+        }
+        if self.next_request_at.is_some()
+            && !(candidate.recent_completion && self.allow_urgent_at.is_some_and(|at| at <= now))
+        {
+            return Some("paced");
+        }
+        if candidate.kind() == Operation::History
+            && !candidate.urgency
+            && candidate.age < 2 * HOUR
+            && self.remaining <= self.reserve + 2
+            && state.demand.expect_busy(now)
+        {
+            return Some("paced");
+        }
+        None
+    }
+}
+
+pub(super) fn pick<'a>(
+    candidates: impl Iterator<Item = &'a Candidate>,
+    usage: &Usage,
+) -> Option<&'a Candidate> {
+    let mut streamer = None;
+    let mut regular = None;
+    for candidate in candidates {
+        let best = if candidate.task.streamer {
+            &mut streamer
+        } else {
+            &mut regular
+        };
+        if best.is_none_or(|current: &Candidate| {
+            if (candidate.score - current.score).abs() <= 20 {
+                let candidate_repeated = usage.last_player == Some(candidate.task.account());
+                let current_repeated = usage.last_player == Some(current.task.account());
+                if candidate_repeated != current_repeated {
+                    return !candidate_repeated;
+                }
+            }
+            (
+                candidate.score,
+                candidate.age,
+                candidate.task.account(),
+                candidate.match_id,
+            ) > (
+                current.score,
+                current.age,
+                current.task.account(),
+                current.match_id,
+            )
+        }) {
+            *best = Some(candidate);
+        }
+    }
+    match (streamer, regular) {
+        (Some(s), Some(r)) if r.age >= 6 * HOUR && r.age > s.age => Some(r),
+        (Some(s), Some(r)) if usage.streamer_streak >= 2 && s.score - r.score <= 70 => Some(r),
+        (Some(s), Some(r)) if r.score > s.score => Some(r),
+        (Some(s), _) => Some(s),
+        (_, Some(r)) => Some(r),
+        _ => None,
+    }
+}
+
+#[derive(Default, Serialize)]
+pub(super) struct Simulated {
+    pub(super) history: usize,
+    pub(super) metadata: usize,
+}
+
+#[derive(Serialize)]
+pub(super) struct Observation {
+    mode: Mode,
+    pub(super) status: &'static str,
+    pub(super) observed_at: i64,
+    pub(super) history: Option<Budget>,
+    pub(super) metadata: Option<Budget>,
+    queued_streamer: Option<usize>,
+    queued_regular: Option<usize>,
+    oldest_wait_seconds: Option<i64>,
+    pub(super) decisions: Vec<Decision>,
+    pub(super) totals: Option<Totals>,
+    pub(super) simulated: Simulated,
+}
+
+impl Observation {
+    pub(super) fn new(mode: Mode, now: i64) -> Self {
+        Self {
+            mode,
+            status: "blocked",
+            observed_at: now,
+            history: None,
+            metadata: None,
+            queued_streamer: None,
+            queued_regular: None,
+            oldest_wait_seconds: None,
+            decisions: Vec::new(),
+            totals: None,
+            simulated: Simulated::default(),
+        }
+    }
+
+    pub(super) fn count(&mut self, tasks: &[Task], now: i64) {
+        let streamers: HashSet<_> = tasks
+            .iter()
+            .filter(|task| task.streamer)
+            .map(Task::account)
+            .collect();
+        let regulars: HashSet<_> = tasks
+            .iter()
+            .filter(|task| !streamers.contains(&task.account()))
+            .map(Task::account)
+            .collect();
+        self.queued_streamer = Some(streamers.len());
+        self.queued_regular = Some(regulars.len());
+        self.oldest_wait_seconds = Some(
+            tasks
+                .iter()
+                .map(|task| (now - task.waiting()).max(0))
+                .max()
+                .unwrap_or_default(),
+        );
+    }
+
+    pub(super) fn publish(&self, path: &Path) -> Result<(), std::io::Error> {
+        let tmp = path.with_extension("json.tmp");
+        let file = File::create(&tmp)?;
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::PermissionsExt as _;
+            file.set_permissions(std::fs::Permissions::from_mode(0o644))?;
+        }
+        serde_json::to_writer(file, self)?;
+        std::fs::rename(tmp, path)
+    }
+}
