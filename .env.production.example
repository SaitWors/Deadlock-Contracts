# Copy to .env.production and replace values.
DOMAIN=contracts.example.com
ACME_EMAIL=admin@example.com
CONTACT_EMAIL=privacy@example.com
COMPANION_DOWNLOAD_URL=https://contracts.example.com/downloads/companion/Deadlock-Contracts-Companion-0.5.2-alpha.18.opk

# Emergency product controls. Ads remain off until explicit Overwolf ad QA.
COMPANION_INGEST_ENABLED=true
COMPANION_ADS_ENABLED=false
COMPANION_MINIMUM_VERSION=0.5.2-alpha.5

# Companion-first settlement stays allowlist-only until the real Alpha.17 canary passes.
GEP_SETTLEMENT_ENABLED=false
GEP_SETTLEMENT_ALLOW_ALL=false
GEP_SETTLEMENT_ALLOWLIST=
GEP_SETTLEMENT_LEADERBOARD_ELIGIBLE=false

# Deadlock API is an asynchronous, non-authoritative audit for the new GEP path.
MATCH_AUDIT_ENABLED=false
MATCH_AUDIT_MAX_ATTEMPTS=24
MATCH_AUDIT_RETRY_SECONDS=900

REWARD_SETTLEMENT_ENABLED=true

# Admins for the internal AutoReview queue (comma-separated SteamID64).
ADMIN_STEAM_IDS=

# Optional provider tuning.
DEADLOCK_API_KEY_HEADER=X-API-Key
DEADLOCK_FORCE_REFETCH=false
DISCOVERY_RETRY_SECONDS=600
MAX_DISCOVERY_ATTEMPTS=180
GLOBAL_RATE_LIMIT_PER_MINUTE=240
AUTH_RATE_LIMIT_PER_10_MINUTES=30
SYNC_RATE_LIMIT_PER_HOUR=20
TRUSTED_PROXY_NETWORKS=172.16.0.0/12,10.0.0.0/8

# Closed Alpha / Overwolf QA reviewer gateway
CLOSED_ALPHA=true
ALPHA_ALLOWED_STEAM_IDS=
OVERWOLF_QA_ACCESS_ENABLED=true
# SHA-256 of the private code already supplied to Overwolf QA; never store the plaintext here.
OVERWOLF_QA_ACCESS_CODE_HASH=
OVERWOLF_QA_ACCESS_UNTIL=2026-10-01T00:00:00Z
