{
  email {$ACME_EMAIL}
  admin off
}

{$DOMAIN}, www.{$DOMAIN} {
  encode zstd gzip

  @www host www.{$DOMAIN}
  redir @www https://{$DOMAIN}{uri} permanent

  header {
    -Server
  }

  reverse_proxy web:8080 {
    health_uri /api/health
    health_status 200
    health_headers {
      Host {$DOMAIN}
    }
    health_interval 30s
    health_timeout 3s
  }

}
