+//! Execute Contract Relay work through the one upstream GC session and journal.
+
+use std::collections::{HashMap, HashSet};
+use std::path::Path;
+use std::sync::Mutex;
+
+use tracing::{info, warn};
+
+use super::api::{self, HistoryRow};
+use super::auth::AuthContext;
+use super::client::GcSession;
+use super::error::GcError;
+use super::scheduler::{
+    self, Budget, Candidate, DAY, HOUR, Mode, Observation, Operation, Settings, State, Task,
+};
+use super::store::{AccountState, GcStore, now_secs};
+use super::{blocking, game_running, post};
+use crate::ingestion_cache::Source;
+
+const PERSONA_INTERVAL: i64 = 5 * 60;
+const API_CACHE_TTL: i64 = 5 * 60;
+
+#[derive(Clone)]
+struct Cached {
+    accounts: Vec<u32>,
+    until: i64,
+    history: HashMap<u32, Vec<HistoryRow>>,
+    metadata: HashMap<u64, Option<scheduler::GameMode>>,
+}
+
+static CACHE: Mutex<Option<Cached>> = Mutex::new(None);
+static API_RETRY_AFTER: Mutex<i64> = Mutex::new(0);
+
+async fn preflight(tasks: &[Task], state: &State, now: i64) -> Result<Cached, GcError> {
+    let mut accounts: Vec<_> = tasks.iter().map(Task::account).collect();
+    accounts.sort_unstable();
+    accounts.dedup();
+    if let Some(cached) = CACHE.lock().ok().and_then(|cache| cache.clone())
+        && cached.accounts == accounts
+        && cached.until > now
+    {
+        return Ok(cached);
+    }
+    let tasks = tasks.to_vec();
+    let found = state.found.clone();
+    let cached = blocking(move || {
+        let history = api::recent_stored(&accounts)?;
+        let mut ids: Vec<_> = tasks
+            .iter()
+            .flat_map(|task| {
+                history
+                    .get(&task.account())
+                    .into_iter()
+                    .flatten()
+                    .chain(found.get(&task.account()).into_iter().flatten())
+                    .filter(|row| task.is_relevant(row, now))
+                    .map(|row| row.match_id)
+                    .chain(task.match_id)
+            })
+            .collect();
+        ids.sort_unstable();
+        ids.dedup();
+        let metadata = api::stored_metadata(&ids)?;
+        Ok(Cached {
+            accounts,
+            until: now + API_CACHE_TTL,
+            history,
+            metadata,
+        })
+    })
+    .await?;
+    if let Ok(mut cache) = CACHE.lock() {
+        *cache = Some(cached.clone());
+    }
+    Ok(cached)
+}
+
+/// The bulk history rows do not carry game mode. Only a supported mode in the
+/// stored match metadata (or a typed local GC response) can establish a mode match.
+fn stored_relevant(
+    task: &Task,
+    row: &HistoryRow,
+    data: &HashMap<u64, Option<scheduler::GameMode>>,
+    now: i64,
+) -> bool {
+    task.is_relevant(row, now) && data.get(&row.match_id).copied().flatten() == Some(task.game_mode)
+}
+
+fn record_hit(state: &mut State, id: u64, now: i64) {
+    if state.api_seen.insert(id, now).is_none() {
+        state.totals.api_hits += 1;
+    }
+}
+
+fn candidates(
+    tasks: &[Task],
+    data: &Cached,
+    state: &mut State,
+    now: i64,
+    obs: &mut Observation,
+) -> Vec<Candidate> {
+    let mut candidates = Vec::new();
+    let mut id_counts = HashMap::<u64, HashSet<u32>>::new();
+    for task in tasks {
+        let Some(history) = data.history.get(&task.account()) else {
+            // The provider omits protected accounts, including from an otherwise healthy result.
+            obs.decisions.push(
+                Candidate::new(task.clone(), task.match_id, state, now).decision("not_available"),
+            );
+            continue;
+        };
+        if let Some(id) = task.match_id {
+            let candidate = Candidate::new(task.clone(), Some(id), state, now);
+            if data.metadata.contains_key(&id) {
+                record_hit(state, id, now);
+                obs.decisions.push(candidate.decision("api_hit"));
+            } else {
+                candidates.push(candidate);
+                id_counts.entry(id).or_default().insert(task.account());
+            }
+            continue;
+        }
+
+        let mut from_history = false;
+        for row in history
+            .iter()
+            .filter(|row| stored_relevant(task, row, &data.metadata, now))
+        {
+            record_hit(state, row.match_id, now);
+            obs.decisions.push(
+                Candidate::new(task.clone(), Some(row.match_id), state, now).decision("api_hit"),
+            );
+            from_history = true;
+        }
+        let locally_proven: Vec<_> = state
+            .found
+            .get(&task.account())
+            .into_iter()
+            .flatten()
+            .filter(|row| task.is_relevant(row, now))
+            .map(|row| row.match_id)
+            .collect();
+        for id in locally_proven {
+            let candidate = Candidate::new(task.clone(), Some(id), state, now);
+            if data.metadata.contains_key(&id) {
+                record_hit(state, id, now);
+                obs.decisions.push(candidate.decision("api_hit"));
+            } else if !candidates
+                .iter()
+                .any(|candidate| candidate.task == *task && candidate.match_id == Some(id))
+            {
+                candidates.push(candidate);
+                id_counts.entry(id).or_default().insert(task.account());
+            }
+            from_history = true;
+        }
+        if !from_history {
+            candidates.push(Candidate::new(task.clone(), None, state, now));
+        }
+    }
+    for (id, accounts) in id_counts {
+        if accounts.len() > 1 && state.seen_duplicates.insert(id, now).is_none() {
+            state.totals.duplicates += (accounts.len() - 1) as u64;
+        }
+    }
+    candidates
+}
+
+fn budget(
+    account: &AccountState,
+    state: &State,
+    settings: &Settings,
+    kind: Operation,
+    now: i64,
+) -> Budget {
+    let hits = match kind {
+        Operation::History => &account.history_hits,
+        Operation::Metadata => &account.quota_hits,
+    };
+    Budget::new(hits, settings.limit(kind), kind, state, now)
+}
+
+fn is_live(
+    session: &GcSession,
+    candidate: &Candidate,
+    settings: &Settings,
+    roster: &Path,
+    bot: u64,
+    now: i64,
+) -> bool {
+    session.confirmed_friend(candidate.task.account())
+        && scheduler::tasks(settings, roster, bot, now)
+            .is_some_and(|tasks| tasks.contains(&candidate.task))
+}
+
+fn api_failure(error: &GcError, state: &mut State, now: i64) {
+    state.api_after = match error {
+        GcError::ApiBackoff(until) => *until,
+        _ => now + API_CACHE_TTL,
+    };
+    if let Ok(mut after) = API_RETRY_AFTER.lock() {
+        *after = state.api_after;
+    }
+    warn!("gc: scheduler cache preflight unavailable: {error}");
+}
+
+async fn precheck_history(candidate: &Candidate, state: &mut State) -> Option<&'static str> {
+    let player = candidate.task.account();
+    let task = candidate.task.clone();
+    let now = now_secs();
+    let fresh_history = blocking(move || {
+        let fresh = api::recent_stored(&[player])?;
+        let Some(rows) = fresh.get(&player) else {
+            return Ok(None);
+        };
+        let ids: Vec<_> = rows
+            .iter()
+            .filter(|row| task.is_relevant(row, now))
+            .map(|row| row.match_id)
+            .collect();
+        let metadata = api::stored_metadata(&ids)?;
+        Ok(Some(
+            rows.iter()
+                .find(|row| stored_relevant(&task, row, &metadata, now))
+                .map(|row| row.match_id),
+        ))
+    })
+    .await;
+    match fresh_history {
+        Ok(None) => return Some("not_available"),
+        Ok(Some(Some(id))) => {
+            if let Ok(mut cache) = CACHE.lock() {
+                *cache = None;
+            }
+            record_hit(state, id, now_secs());
+            return Some("api_hit");
+        }
+        Ok(Some(None)) => {}
+        Err(error) => {
+            api_failure(&error, state, now_secs());
+            return Some("api_unavailable");
+        }
+    }
+    None
+}
+
+fn record_history(rows: Vec<HistoryRow>, player: u32, tasks: &[Task], state: &mut State, now: i64) {
+    let rows: Vec<_> = rows
+        .into_iter()
+        .filter(|row| {
+            tasks.iter().any(|task| {
+                task.account() == player
+                    && task.operation == Operation::History
+                    && task.is_relevant(row, now)
+            })
+        })
+        .collect();
+    if rows.is_empty() {
+        state.totals.history_empty += 1;
+        state.history_empty.insert(player);
+    } else {
+        state.totals.history_useful += 1;
+        state.history_empty.remove(&player);
+        state.history_after.insert(player, now + 3 * HOUR);
+        let mut seen: HashSet<_> = state
+            .found
+            .values()
+            .flatten()
+            .map(|row| row.match_id)
+            .collect();
+        let found = state.found.entry(player).or_default();
+        for row in rows {
+            if !found
+                .iter()
+                .any(|existing| existing.match_id == row.match_id)
+            {
+                state.totals.discovered_matches += u64::from(seen.insert(row.match_id));
+                found.push(row);
+            }
+        }
+    }
+}
+
+#[allow(clippy::too_many_arguments)]
+async fn serve(
+    session: &GcSession,
+    candidate: &Candidate,
+    tasks: &[Task],
+    settings: &Settings,
+    roster: &Path,
+    ctx: &AuthContext,
+    store: &GcStore,
+    state: &mut State,
+    sys: &mut sysinfo::System,
+) -> Result<&'static str, GcError> {
+    let bot = ctx.steam_id64;
+    if !is_live(session, candidate, settings, roster, bot, now_secs()) {
+        return Ok("no_friendship");
+    }
+    if let Some(id) = candidate.match_id {
+        if store.given_up_matches()?.contains(&id) {
+            return Ok("not_available");
+        }
+        // Recheck near dispatch even if the warm metadata batch did not yet have the match.
+        let cached = blocking(move || Ok(api::stored_metadata(&[id])?.contains_key(&id))).await;
+        match cached {
+            Ok(true) => {
+                record_hit(state, id, now_secs());
+                return Ok("api_hit");
+            }
+            Ok(false) => {}
+            Err(error) => {
+                api_failure(&error, state, now_secs());
+                return Ok("api_unavailable");
+            }
+        }
+    }
+    if candidate.match_id.is_none()
+        && let Some(reason) = precheck_history(candidate, state).await
+    {
+        return Ok(reason);
+    }
+    // Check the same signed work and live friendship after the GC handshake, immediately
+    // before recording the attempt and sending the job. Only this callback spends quota.
+    let before_send = || {
+        let now = now_secs();
+        if game_running(sys) || !is_live(session, candidate, settings, roster, bot, now) {
+            return Err(GcError::RelayCancelled);
+        }
+        store.relay_charge(bot, state, candidate, settings, now)
+    };
+    if let Some(id) = candidate.match_id {
+        let result = session.fetch_salts_guarded(id, before_send).await;
+        match result {
+            Ok(salts) => {
+                if post(salts, Source::Gc).await {
+                    state.totals.metadata_posted += 1;
+                }
+            }
+            Err(
+                error @ (GcError::RelayCancelled
+                | GcError::GcRateLimited
+                | GcError::GcHandshakeFailed(_)
+                | GcError::AccountInUse
+                | GcError::Store(_)),
+            ) => return Err(error),
+            // Attempt and cooldown were persisted before this uncertain response.
+            Err(_) => {}
+        }
+    } else {
+        let player = candidate.task.account();
+        let result = session.fetch_history_guarded(player, before_send).await;
+        let now = now_secs();
+        match result {
+            Ok(rows) => record_history(rows, player, tasks, state, now),
+            Err(GcError::HistoryPrivate) => {
+                state.history_after.insert(player, now + 7 * DAY);
+            }
+            Err(
+                error @ (GcError::RelayCancelled
+                | GcError::GcRateLimited
+                | GcError::GcHandshakeFailed(_)
+                | GcError::AccountInUse
+                | GcError::Store(_)),
+            ) => return Err(error),
+            // An uncertain response remains a charged attempt with the pre-send cooldown.
+            Err(_) => {}
+        }
+    }
+    Ok("selected")
+}
+
+#[allow(
+    clippy::too_many_arguments,
+    clippy::too_many_lines,
+    reason = "single dispatch boundary for both quota lanes and their decision telemetry"
+)]
+async fn dispatch(
+    picks: &[Candidate],
+    tasks: &[Task],
+    session: Option<&GcSession>,
+    settings: &Settings,
+    roster: &Path,
+    ctx: &AuthContext,
+    store: &GcStore,
+    account: &AccountState,
+    state: &mut State,
+    sys: &mut sysinfo::System,
+    obs: &mut Observation,
+    planned: &impl Fn(&Candidate, &State) -> Option<&'static str>,
+    now: i64,
+) {
+    let bot = ctx.steam_id64;
+    // Dispatch at most one of the two operation types per pass, trying exact IDs first.
+    // The next pass is one minute later, above Steam's minimum 20 seconds between requests.
+    let mut dispatched = false;
+    for kind in [Operation::Metadata, Operation::History] {
+        let by_kind = || picks.iter().filter(|candidate| candidate.kind() == kind);
+        let best = scheduler::pick(
+            by_kind()
+                .filter(|candidate| !dispatched && planned(candidate, state).is_none())
+                .filter(|candidate| {
+                    session.is_none_or(|session| session.confirmed_friend(candidate.task.account()))
+                }),
+            state.usage(kind),
+        );
+        let mut stop = false;
+        for candidate in by_kind() {
+            let reason = if best.is_some_and(|best| core::ptr::eq(candidate, best)) {
+                match session {
+                    Some(session) => match serve(
+                        session, candidate, tasks, settings, roster, ctx, store, state, sys,
+                    )
+                    .await
+                    {
+                        Ok(reason) => {
+                            stop = matches!(reason, "selected" | "api_unavailable");
+                            reason
+                        }
+                        Err(GcError::GcRateLimited) => {
+                            let until = now_secs() + DAY;
+                            state.usage_mut(kind).rate_limited_until = Some(until);
+                            if let Err(error) = store.relay_rate_limit(bot, kind, until) {
+                                warn!("gc: scheduler cannot persist Steam rate limit: {error}");
+                                obs.status = "blocked";
+                            }
+                            stop = true;
+                            "rate_limited"
+                        }
+                        Err(GcError::RelayCancelled) => "stale_input",
+                        Err(GcError::AccountInUse) => {
+                            stop = true;
+                            "not_available"
+                        }
+                        Err(GcError::GcHandshakeFailed(_)) => {
+                            if let Err(error) = store.set_backoff(bot, Some(now_secs() + HOUR)) {
+                                warn!("gc: scheduler cannot persist GC backoff: {error}");
+                            }
+                            stop = true;
+                            "not_available"
+                        }
+                        Err(error) => {
+                            warn!("gc: scheduler GC request stopped: {error}");
+                            obs.status = "blocked";
+                            "not_available"
+                        }
+                    },
+                    None if settings.mode == Mode::Shadow => {
+                        match kind {
+                            Operation::History => obs.simulated.history += 1,
+                            Operation::Metadata => obs.simulated.metadata += 1,
+                        }
+                        "selected"
+                    }
+                    None => "not_available",
+                }
+            } else if session
+                .is_some_and(|session| !session.confirmed_friend(candidate.task.account()))
+            {
+                "no_friendship"
+            } else if candidate.match_id.is_some()
+                && best.is_some_and(|best| candidate.match_id == best.match_id)
+            {
+                "duplicate"
+            } else {
+                planned(candidate, state).unwrap_or("paced")
+            };
+            let quota = budget(account, state, settings, kind, now);
+            obs.decisions.push(
+                candidate
+                    .decision(reason)
+                    .scheduled(&quota, candidate, state, now),
+            );
+        }
+        dispatched |= stop;
+        if obs.status == "blocked" {
+            break;
+        }
+    }
+}
+
+async fn observe_personas(session: &GcSession, picks: &[Candidate], state: &mut State) {
+    let accounts: HashSet<_> = picks
+        .iter()
+        .filter(|pick| {
+            pick.kind() == Operation::History && session.confirmed_friend(pick.task.account())
+        })
+        .map(|pick| pick.task.account())
+        .collect();
+    let personas = session
+        .request_personas(&accounts.iter().copied().collect::<Vec<_>>())
+        .await;
+    let observed_at = now_secs();
+    for account_id in accounts {
+        state
+            .people
+            .entry(account_id)
+            .or_default()
+            .observe(personas.get(&account_id).copied(), observed_at);
+    }
+    state.next_persona_at = observed_at + PERSONA_INTERVAL;
+}
+
+#[allow(
+    clippy::too_many_lines,
+    reason = "one pass owns the complete read-plan-dispatch-report sequence"
+)]
+pub(super) async fn run(
+    contexts: &[AuthContext],
+    store: &GcStore,
+    sys: &mut sysinfo::System,
+    settings: &Settings,
+    roster: &Path,
+    mut obs: Observation,
+) -> Observation {
+    let now = now_secs();
+    let context = contexts
+        .iter()
+        .find(|ctx| super::relay::current_participants(roster, ctx.steam_id64, now).is_some())
+        .or_else(|| {
+            if contexts.len() == 1 {
+                contexts.first()
+            } else {
+                None
+            }
+        });
+    let Some(ctx) = context else {
+        obs.status = "stale_input";
+        return obs;
+    };
+    let bot = ctx.steam_id64;
+    let mut account = match store.relay_account(bot, now) {
+        Ok(account) => account,
+        Err(error) => {
+            warn!("gc: scheduler journal blocked: {error}");
+            return obs;
+        }
+    };
+    let mut state = account.scheduler.take().unwrap_or_default();
+    obs.history = Some(budget(&account, &state, settings, Operation::History, now));
+    obs.metadata = Some(budget(&account, &state, settings, Operation::Metadata, now));
+    obs.totals = Some(state.totals.clone());
+    let Some(tasks) = scheduler::tasks(settings, roster, bot, now) else {
+        obs.status = "stale_input";
+        return obs;
+    };
+    obs.count(&tasks, now);
+    let players = tasks
+        .iter()
+        .map(Task::account)
+        .collect::<HashSet<_>>()
+        .len();
+    state.demand.observe(players, now);
+    if tasks.is_empty() {
+        obs.status = "no_tasks";
+        if settings.mode == Mode::Active
+            && let Err(error) = store.relay_update(bot, &state)
+        {
+            warn!("gc: scheduler demand journal failed: {error}");
+            obs.status = "blocked";
+        }
+        return obs;
+    }
+
+    if state.api_after > now || API_RETRY_AFTER.lock().is_ok_and(|until| *until > now) {
+        obs.status = "api_unavailable";
+        return obs;
+    }
+    let data = match preflight(&tasks, &state, now).await {
+        Ok(data) => data,
+        Err(error) => {
+            api_failure(&error, &mut state, now);
+            if settings.mode == Mode::Active
+                && let Err(error) = store.relay_update(bot, &state)
+            {
+                warn!("gc: scheduler API backoff journal failed: {error}");
+                return obs;
+            }
+            obs.status = "api_unavailable";
+            return obs;
+        }
+    };
+    state.prune(&tasks, now);
+    let mut picks = candidates(&tasks, &data, &mut state, now, &mut obs);
+    let given_up = match store.given_up_matches() {
+        Ok(given_up) => given_up,
+        Err(error) => {
+            warn!("gc: scheduler metadata attempt journal blocked: {error}");
+            return obs;
+        }
+    };
+    let planned = |pick: &Candidate, state: &State| {
+        if pick.match_id.is_some_and(|id| given_up.contains(&id)) {
+            return Some("not_available");
+        }
+        let kind = pick.kind();
+        if kind == Operation::History
+            && budget(&account, state, settings, Operation::Metadata, now).exhausted()
+        {
+            return Some("quota");
+        }
+        budget(&account, state, settings, kind, now).reason(pick, state, now)
+    };
+    let persona_due = state.next_persona_at <= now
+        && !budget(&account, &state, settings, Operation::History, now).exhausted()
+        && !budget(&account, &state, settings, Operation::Metadata, now).exhausted()
+        && picks.iter().any(|pick| pick.kind() == Operation::History);
+    let steam_due = picks.iter().any(|pick| planned(pick, &state).is_none());
+    let backed_off = store
+        .relay_backoff(bot)
+        .is_ok_and(|until| until.is_some_and(|until| until > now));
+    let session = if settings.mode == Mode::Active
+        && (persona_due || steam_due)
+        && !backed_off
+        && !game_running(sys)
+    {
+        match GcSession::connect(ctx).await {
+            Ok(session) => Some(session),
+            Err(error) => {
+                if !matches!(error, GcError::AccountInUse) {
+                    warn!("gc: scheduler Steam session unavailable: {error}");
+                    if let Err(error) = store.set_backoff(bot, Some(now + HOUR)) {
+                        warn!("gc: scheduler cannot persist Steam backoff: {error}");
+                    }
+                }
+                None
+            }
+        }
+    } else {
+        None
+    };
+    if let Some(session) = &session
+        && persona_due
+    {
+        observe_personas(session, &picks, &mut state).await;
+        let observed_at = now_secs();
+        picks = picks
+            .into_iter()
+            .map(|candidate| {
+                Candidate::new(candidate.task, candidate.match_id, &state, observed_at)
+            })
+            .collect();
+    }
+
+    obs.status = if settings.mode == Mode::Active && (steam_due || persona_due) && session.is_none()
+    {
+        "session_unavailable"
+    } else {
+        "ready"
+    };
+    dispatch(
+        &picks,
+        &tasks,
+        session.as_ref(),
+        settings,
+        roster,
+        ctx,
+        store,
+        &account,
+        &mut state,
+        sys,
+        &mut obs,
+        &planned,
+        now,
+    )
+    .await;
+    if settings.mode == Mode::Active {
+        state.latest_clock = state.latest_clock.max(now_secs());
+        if let Err(error) = store.relay_update(bot, &state) {
+            warn!("gc: scheduler journal update failed: {error}");
+            obs.status = "blocked";
+        }
+        if let Ok(reloaded) = store.relay_account(bot, now_secs()) {
+            account = reloaded;
+        } else {
+            obs.history = None;
+            obs.metadata = None;
+            return obs;
+        }
+        obs.totals = Some(state.totals.clone());
+    }
+    obs.history = Some(budget(
+        &account,
+        &state,
+        settings,
+        Operation::History,
+        now_secs(),
+    ));
+    obs.metadata = Some(budget(
+        &account,
+        &state,
+        settings,
+        Operation::Metadata,
+        now_secs(),
+    ));
+    obs.decisions
+        .sort_by_key(|decision| core::cmp::Reverse((decision.selected(), decision.score())));
+    obs.decisions.truncate(30);
+    info!("gc: scheduler pass complete");
+    obs
+}
