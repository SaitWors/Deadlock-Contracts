+#[cfg(test)]
+mod tests {
+    use super::super::scheduler::{Mode, Task};
+    use super::*;
+
+    #[test]
+    fn precharge_survives_restart_and_missing_or_malformed_state_is_blocked() {
+        const NOW: i64 = 86_401;
+        const BOT: u64 = 76561197960265731;
+        let nonce = std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .unwrap()
+            .as_nanos();
+        let dir =
+            std::env::temp_dir().join(format!("relay-journal-{}-{nonce}", std::process::id()));
+        std::fs::create_dir(&dir).unwrap();
+        let open = || GcStore {
+            path: dir.join(STORE_FILE),
+            _lock: File::create(dir.join(LOCK_FILE)).unwrap(),
+        };
+        let store = open();
+        assert!(store.relay_account(BOT, NOW).is_err());
+        std::fs::write(
+            &store.path,
+            br#"{"accounts":{"76561197960265731":{"quota_hits":[]}}}"#,
+        )
+        .unwrap();
+        assert!(store.relay_account(BOT, NOW).is_err());
+        std::fs::write(
+            &store.path,
+            br#"{"accounts":{"76561197960265731":{"quota_hits":[],"history_hits":[]}}}"#,
+        )
+        .unwrap();
+        let task: Task = serde_json::from_value(serde_json::json!({
+            "steam_id64": "76561197960265732",
+            "operation": "metadata",
+            "match_id": 42,
+            "waiting_since": "1970-01-01T23:00:00+00:00",
+            "locked_at": "1970-01-01T22:00:00+00:00",
+            "baseline_match_id": 30,
+            "streamer": true,
+            "game_mode": "STANDARD",
+            "metadata_required": true,
+            "evidence": "stored_history"
+        }))
+        .unwrap();
+        let settings = Settings {
+            mode: Mode::Active,
+            queue: dir.join("queue"),
+            status: dir.join("status"),
+            history_limit: 20,
+            metadata_limit: 40,
+        };
+        let mut state = State::default();
+        let candidate = Candidate::new(task, Some(42), &state, NOW);
+        store
+            .relay_charge(BOT, &mut state, &candidate, &settings, NOW)
+            .unwrap();
+        drop(store);
+        let reopened = open();
+        let account = reopened.relay_account(BOT, NOW + 1).unwrap();
+        assert_eq!(account.quota_hits, [NOW]);
+        assert_eq!(reopened.load().unwrap().salt_attempts.get(&42), Some(&1));
+        let mut state = account.scheduler.unwrap();
+        assert!(matches!(
+            reopened.relay_charge(BOT, &mut state, &candidate, &settings, NOW + 1),
+            Err(GcError::RelayCancelled)
+        ));
+        assert_eq!(
+            reopened
+                .relay_account(BOT, NOW + 1)
+                .unwrap()
+                .quota_hits
+                .len(),
+            1
+        );
+        assert!(reopened.relay_account(BOT, NOW - 1).is_err());
+        drop(reopened);
+        std::fs::remove_file(dir.join(STORE_FILE)).unwrap();
+        std::fs::remove_file(dir.join(LOCK_FILE)).unwrap();
+        std::fs::remove_dir(dir).unwrap();
+    }
