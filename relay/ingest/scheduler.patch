+/// The API's ClickHouse-only bulk route. A returned empty history is distinct from
+/// an omitted player, whose API privacy request must be respected.
+pub(super) fn recent_stored(account_ids: &[u32]) -> Result<HashMap<u32, Vec<HistoryRow>>, GcError> {
+    #[derive(Deserialize)]
+    struct Player {
+        account_id: u32,
+        matches: Vec<HistoryRow>,
+    }
+    const RECENT: &str = "https://api.deadlock-api.com/v1/players/recent-matches";
+    if account_ids.is_empty() {
+        return Ok(HashMap::new());
+    }
+    let request = client()
+        .get(RECENT)
+        .query("account_ids", join_ids(account_ids))
+        .query("limit", "20");
+    let rows: Vec<Player> = read_cache(request, "stored history")?
+        .ok_or_else(|| GcError::Api("stored history route unavailable".into()))?;
+    Ok(rows
+        .into_iter()
+        .map(|row| (row.account_id, row.matches))
+        .collect())
+}
+
+#[derive(Deserialize)]
+struct StoredMetadata {
+    match_id: u64,
+    match_mode: Option<String>,
+    game_mode: Option<String>,
+}
+
+pub(super) fn stored_metadata(
+    match_ids: &[u64],
+) -> Result<HashMap<u64, Option<GameMode>>, GcError> {
+    let mut found = HashMap::new();
+    for chunk in match_ids.chunks(METADATA_CHUNK) {
+        let request = client()
+            .get(METADATA_URL)
+            .query("match_ids", join_ids(chunk))
+            .query("include_info", "true")
+            .query("game_mode", "")
+            .query("match_mode", "unranked,ranked,new_player_placement")
+            .query("limit", METADATA_CHUNK.to_string());
+        let rows: Vec<StoredMetadata> = read_cache(request, "stored metadata")?.unwrap_or_default();
+        found.extend(rows.into_iter().map(|row| {
+            let mode = match (row.match_mode.as_deref(), row.game_mode.as_deref()) {
+                (Some("Unranked"), Some("Normal")) => Some(GameMode::Standard),
+                (Some("Ranked" | "NewPlayerPlacement"), Some("Normal")) => Some(GameMode::Ranked),
+                (Some("Unranked"), Some("StreetBrawl")) => Some(GameMode::StreetBrawl),
+                _ => None,
+            };
+            (row.match_id, mode)
+        }));
+    }
+    Ok(found)
+}
+
+fn read_cache<T: DeserializeOwned>(
+    request: ureq::RequestBuilder<ureq::typestate::WithoutBody>,
+    label: &str,
+) -> Result<Option<T>, GcError> {
+    let mut response = request
+        .config()
+        .http_status_as_error(false)
+        .build()
+        .call()
+        .map_err(|error| GcError::Api(format!("{label}: {error}")))?;
+    match response.status().as_u16() {
+        200 => read_json(&mut response, label).map(Some),
+        404 => Ok(None),
+        code @ (429 | 503 | 504) => {
+            let now = now_secs();
+            let until = response
+                .headers()
+                .get("retry-after")
+                .and_then(|value| value.to_str().ok())
+                .and_then(|value| {
+                    value
+                        .parse::<i64>()
+                        .ok()
+                        .map(|seconds| now.saturating_add(seconds))
+                        .or_else(|| {
+                            chrono::DateTime::parse_from_rfc2822(value)
+                                .ok()
+                                .map(|date| date.timestamp())
+                        })
+                })
+                .unwrap_or(now + 5 * 60)
+                .max(now + 60);
+            warn!("gc: {label} API status {code}; honoring retry backoff");
+            Err(GcError::ApiBackoff(until))
+        }
+        code => Err(GcError::Api(format!("{label}: status {code}"))),
+    }
+}
