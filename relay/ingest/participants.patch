index 0000000..ecb4928
--- /dev/null
+++ b/src/gc/relay.rs
@@ -0,0 +1,81 @@
+//! Read the roster published by the local Contract Relay Manager.
+
+use std::collections::HashSet;
+use std::fs::File;
+use std::io::Read as _;
+use std::path::Path;
+
+use serde::Deserialize;
+
+const MAX_BYTES: u64 = 128 * 1024;
+const MAX_TTL: i64 = 120;
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Roster {
+    schema_version: u8,
+    steam_id64: String,
+    valid_until: i64,
+    accounts: Vec<u32>,
+}
+
+fn parse(bytes: &[u8], steam_id64: u64, now: i64) -> Option<HashSet<u32>> {
+    if bytes.len() as u64 > MAX_BYTES {
+        return None;
+    }
+    let roster: Roster = serde_json::from_slice(bytes).ok()?;
+    if roster.schema_version != 1
+        || roster.steam_id64 != steam_id64.to_string()
+        || roster.valid_until <= now
+        || roster.valid_until > now.saturating_add(MAX_TTL)
+        || roster.accounts.contains(&0)
+    {
+        return None;
+    }
+    Some(roster.accounts.into_iter().collect())
+}
+
+pub(super) fn participants(path: &Path, steam_id64: u64, now: i64) -> HashSet<u32> {
+    let mut bytes = Vec::new();
+    if let Ok(file) = File::open(path)
+        && file.take(MAX_BYTES + 1).read_to_end(&mut bytes).is_ok()
+    {
+        return parse(&bytes, steam_id64, now).unwrap_or_default();
+    }
+    HashSet::new()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const BOT: u64 = 76561197960265729;
+    const ROSTER: &[u8] =
+        br#"{"schema_version":1,"steam_id64":"76561197960265729","valid_until":220,"accounts":[2,42]}"#;
+
+    #[test]
+    fn only_current_roster_for_this_steam_account_is_usable() {
+        assert_eq!(parse(ROSTER, BOT, 100), Some(HashSet::from([2, 42])));
+        assert_eq!(parse(ROSTER, BOT + 1, 100), None);
+        assert_eq!(parse(ROSTER, BOT, 99), None);
+        assert_eq!(parse(ROSTER, BOT, 220), None);
+        assert_eq!(parse(b"{}", BOT, 100), None);
+        assert_eq!(parse(&ROSTER[..ROSTER.len() - 1], BOT, 100), None);
+        assert_eq!(
+            parse(
+                br#"{"schema_version":1,"steam_id64":"76561197960265729","valid_until":220,"accounts":[0]}"#,
+                BOT,
+                100
+            ),
+            None
+        );
+    }
+
+    #[test]
+    fn empty_roster_pauses_collection() {
+        let empty = br#"{"schema_version":1,"steam_id64":"76561197960265729","valid_until":220,"accounts":[]}"#;
+        assert_eq!(parse(empty, BOT, 100), Some(HashSet::new()));
+        let file = Path::new("/not-mounted/relay-participants.json");
+        assert!(participants(file, BOT, 100).is_empty());
+    }
+}
