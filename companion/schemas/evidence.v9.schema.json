{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deadlock-contracts.online/schemas/evidence.v9.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "client_version",
    "device_id",
    "event_type",
    "session_id",
    "idempotency_key",
    "sequence",
    "observed_at"
  ],
  "properties": {
    "schema_version": {
      "const": 9
    },
    "client_version": {
      "const": "0.5.2-alpha.17"
    },
    "device_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "enum": [
        "game_started",
        "game_stopped",
        "match_started",
        "phase_changed",
        "heartbeat",
        "match_ended",
        "interrupted"
      ]
    },
    "session_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 80
    },
    "match_id": {
      "type": [
        "string",
        "integer",
        "null"
      ]
    },
    "match_clock_s": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 21600
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "observed_at": {
      "type": "string",
      "minLength": 1
    },
    "terminal_proof": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "match_ended"
          }
        }
      },
      "then": {
        "required": [
          "match_id",
          "match_clock_s",
          "terminal_proof"
        ]
      }
    }
  ],
  "additionalProperties": true
}
