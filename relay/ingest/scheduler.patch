@@ -0,0 +1,977 @@
+//! Contract Relay policy. Steam is only reached by the execution gate in the parent module.
+
+use std::collections::{HashMap, HashSet};
+use std::fs::File;
+use std::io::Read as _;
+use std::path::{Path, PathBuf};
+
+use chrono::{DateTime, FixedOffset};
+use serde::{Deserialize, Serialize};
+
+use super::api::HistoryRow;
+use super::friends::Persona;
+use super::quota::{FETCH_QUOTA_LIMIT, FETCH_QUOTA_WINDOW_SECS, FRIEND_HISTORY_QUOTA_LIMIT};
+use super::relay;
+
+pub(super) const HOUR: i64 = 3600;
+pub(super) const DAY: i64 = FETCH_QUOTA_WINDOW_SECS;
+const MAX_QUEUE_BYTES: u64 = 64 * 1024;
+const MAX_TASKS: usize = 120;
+const STEAM_BASE: u64 = crate::steam_user::STEAM_ID_64_IDENT;
+const MAX_TTL: i64 = 120;
+const MAX_SIGNAL_AGE: i64 = 15 * 60;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize)]
+#[serde(rename_all = "snake_case")]
+pub(super) enum Mode {
+    Legacy,
+    Shadow,
+    Active,
+}
+
+pub(super) struct Settings {
+    pub(super) mode: Mode,
+    pub(super) queue: PathBuf,
+    pub(super) status: PathBuf,
+    pub(super) history_limit: usize,
+    pub(super) metadata_limit: usize,
+}
+
+fn limit(var: &str, max: usize) -> Result<usize, &'static str> {
+    match std::env::var(var) {
+        Err(std::env::VarError::NotPresent) => Ok(max),
+        Ok(value) => value
+            .parse::<usize>()
+            .ok()
+            .filter(|value| *value <= max)
+            .ok_or("invalid scheduler quota cap"),
+        Err(_) => Err("invalid scheduler quota cap"),
+    }
+}
+
+pub(super) fn configured_limit(kind: Operation) -> Result<usize, &'static str> {
+    match kind {
+        Operation::History => limit("RELAY_HISTORY_LIMIT", FRIEND_HISTORY_QUOTA_LIMIT),
+        Operation::Metadata => limit("RELAY_METADATA_LIMIT", FETCH_QUOTA_LIMIT),
+    }
+}
+
+impl Settings {
+    pub(super) fn read() -> Result<Option<Self>, &'static str> {
+        let mode = match std::env::var("RELAY_SCHEDULER_MODE").as_deref() {
+            Err(std::env::VarError::NotPresent) => return Ok(None),
+            Ok("legacy" | "") if std::env::var_os("RELAY_COLLECTOR_ALLOWLIST").is_some() => {
+                return Ok(None);
+            }
+            Ok("legacy" | "") => return Err("RELAY_COLLECTOR_ALLOWLIST required"),
+            Ok("shadow") => Mode::Shadow,
+            Ok("active") => Mode::Active,
+            _ => return Err("invalid RELAY_SCHEDULER_MODE"),
+        };
+        let allowlist = std::env::var_os("RELAY_COLLECTOR_ALLOWLIST")
+            .ok_or("RELAY_COLLECTOR_ALLOWLIST required")?;
+        let queue = std::env::var_os("RELAY_COLLECTOR_QUEUE").map_or_else(
+            || Path::new(&allowlist).with_file_name("queue.json"),
+            PathBuf::from,
+        );
+        let status =
+            std::env::var_os("RELAY_SCHEDULER_STATUS").ok_or("RELAY_SCHEDULER_STATUS required")?;
+        Ok(Some(Self {
+            mode,
+            queue,
+            status: status.into(),
+            history_limit: configured_limit(Operation::History)?,
+            metadata_limit: configured_limit(Operation::Metadata)?,
+        }))
+    }
+
+    pub(super) const fn limit(&self, kind: Operation) -> usize {
+        match kind {
+            Operation::History => self.history_limit,
+            Operation::Metadata => self.metadata_limit,
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub(super) enum Operation {
+    History,
+    Metadata,
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, Serialize, PartialEq, Eq)]
+#[serde(rename_all = "SCREAMING_SNAKE_CASE")]
+pub(super) enum GameMode {
+    Standard,
+    Ranked,
+    StreetBrawl,
+}
+
+impl GameMode {
+    pub(super) const fn from_provider(
+        match_mode: Option<i32>,
+        game_mode: Option<i32>,
+    ) -> Option<Self> {
+        match (match_mode, game_mode) {
+            (Some(1), Some(1)) => Some(Self::Standard),
+            (Some(4 | 8), Some(1)) => Some(Self::Ranked),
+            (Some(1), Some(4)) => Some(Self::StreetBrawl),
+            _ => None,
+        }
+    }
+
+    pub(super) const fn likely_duration(self) -> i64 {
+        match self {
+            Self::Standard | Self::Ranked => 35 * 60,
+            Self::StreetBrawl => 15 * 60,
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+enum Evidence {
+    None,
+    StoredHistory,
+}
+
+#[derive(Clone, Debug, Deserialize, PartialEq, Eq)]
+#[serde(deny_unknown_fields)]
+pub(super) struct Task {
+    pub(super) steam_id64: String,
+    pub(super) operation: Operation,
+    pub(super) match_id: Option<u64>,
+    pub(super) waiting_since: DateTime<FixedOffset>,
+    pub(super) locked_at: DateTime<FixedOffset>,
+    pub(super) baseline_match_id: Option<u64>,
+    pub(super) streamer: bool,
+    pub(super) game_mode: GameMode,
+    pub(super) metadata_required: bool,
+    evidence: Evidence,
+}
+
+impl Task {
+    pub(super) fn account(&self) -> u32 {
+        self.steam_id64
+            .parse::<u64>()
+            .ok()
+            .and_then(|id| id.checked_sub(STEAM_BASE))
+            .and_then(|id| u32::try_from(id).ok())
+            .unwrap_or_default()
+    }
+
+    pub(super) fn is_relevant(&self, row: &HistoryRow, now: i64) -> bool {
+        row.match_id > self.baseline_match_id.unwrap_or(0)
+            && i64::from(row.start_time) > self.locked_at.timestamp()
+            && row.match_duration_s > 0
+            && i64::from(row.start_time) + i64::from(row.match_duration_s) <= now
+            && row.mode.is_none_or(|mode| mode == self.game_mode)
+    }
+
+    pub(super) const fn waiting(&self) -> i64 {
+        self.waiting_since.timestamp()
+    }
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Queue {
+    protocol_version: u8,
+    schema_version: u8,
+    generated_at: DateTime<FixedOffset>,
+    expires_at: DateTime<FixedOffset>,
+    tasks: Vec<Task>,
+}
+
+fn parse_queue(bytes: &[u8], now: i64) -> Option<Vec<Task>> {
+    if bytes.len() as u64 > MAX_QUEUE_BYTES {
+        return None;
+    }
+    let queue: Queue = serde_json::from_slice(bytes).ok()?;
+    let generated = queue.generated_at.timestamp();
+    let expires = queue.expires_at.timestamp();
+    if queue.protocol_version != 1
+        || queue.schema_version != 1
+        || generated > now + 5
+        || expires <= now
+        || expires <= generated
+        || expires - generated > MAX_TTL
+        || queue.tasks.len() > MAX_TASKS
+        || queue.tasks.iter().any(|task| {
+            task.account() == 0
+                || task.waiting() < task.locked_at.timestamp()
+                || task.waiting() > generated
+                || task.locked_at.timestamp() > generated
+                || match task.operation {
+                    Operation::History => task.match_id.is_some(),
+                    Operation::Metadata => {
+                        task.match_id.is_none_or(|id| id == 0)
+                            || !task.metadata_required
+                            || task.evidence != Evidence::StoredHistory
+                    }
+                }
+        })
+    {
+        return None;
+    }
+    Some(queue.tasks)
+}
+
+pub(super) fn tasks(settings: &Settings, roster: &Path, bot: u64, now: i64) -> Option<Vec<Task>> {
+    let file = File::open(&settings.queue).ok()?;
+    let mut bytes = Vec::new();
+    file.take(MAX_QUEUE_BYTES + 1)
+        .read_to_end(&mut bytes)
+        .ok()?;
+    let roster = relay::current_participants(roster, bot, now)?;
+    // The roster is independently authoritative, including changes during a GC pass.
+    Some(
+        parse_queue(&bytes, now)?
+            .into_iter()
+            .filter(|task| roster.contains(&task.account()))
+            .collect(),
+    )
+}
+
+#[derive(Clone, Default, Deserialize, Serialize)]
+pub(super) struct Person {
+    seen_at: i64,
+    playing_since: Option<i64>,
+    stopped_at: Option<i64>,
+    #[serde(default)]
+    stopped_after_seconds: i64,
+}
+
+impl Person {
+    pub(super) fn observe(&mut self, persona: Option<Persona>, now: i64) {
+        let Some(persona) = persona else { return };
+        // Steam sometimes returns only an ID for a friend with hidden presence.
+        if !persona.in_deadlock && persona.last_seen.is_none() {
+            return;
+        }
+        let recent = now - self.seen_at <= MAX_SIGNAL_AGE;
+        self.seen_at = now;
+        if persona.in_deadlock {
+            if !recent || self.playing_since.is_none() {
+                self.playing_since = Some(now);
+            }
+        } else {
+            if recent && let Some(since) = self.playing_since {
+                self.stopped_at = Some(now);
+                self.stopped_after_seconds = now - since;
+            }
+            self.playing_since = None;
+        }
+    }
+
+    fn bonus(&self, task: &Task, now: i64) -> i64 {
+        if now - self.seen_at > MAX_SIGNAL_AGE {
+            return 0;
+        }
+        if self.stopped_at.is_some_and(|at| {
+            now - at <= MAX_SIGNAL_AGE
+                && at >= task.locked_at.timestamp()
+                && self.stopped_after_seconds >= task.game_mode.likely_duration()
+        }) {
+            40
+        } else if self.playing_since.is_some_and(|at| {
+            now - at.max(task.locked_at.timestamp()) >= task.game_mode.likely_duration()
+        }) {
+            30
+        } else if self.playing_since.is_none() {
+            -15
+        } else {
+            0
+        }
+    }
+}
+
+#[derive(Clone, Default, Deserialize, Serialize)]
+pub(super) struct Usage {
+    streamer_streak: u8,
+    #[serde(default)]
+    last_player: Option<u32>,
+    pub(super) rate_limited_until: Option<i64>,
+}
+
+#[derive(Clone, Default, Deserialize, Serialize)]
+pub(super) struct Totals {
+    history_streamer: u64,
+    history_regular: u64,
+    metadata_streamer: u64,
+    metadata_regular: u64,
+    pub(super) history_useful: u64,
+    pub(super) history_empty: u64,
+    pub(super) api_hits: u64,
+    pub(super) duplicates: u64,
+    pub(super) discovered_matches: u64,
+    pub(super) metadata_posted: u64,
+}
+
+#[derive(Clone, Default, Deserialize, Serialize)]
+pub(super) struct Demand {
+    utc_hour: [Option<usize>; 24],
+    last_sample: Option<i64>,
+}
+
+impl Demand {
+    fn hour_index(hour: i64) -> usize {
+        usize::try_from(hour.rem_euclid(24)).unwrap_or_default()
+    }
+
+    pub(super) fn observe(&mut self, players: usize, now: i64) {
+        let hour = now.div_euclid(HOUR);
+        if self.last_sample == Some(hour) {
+            return;
+        }
+        self.last_sample = Some(hour);
+        let slot = &mut self.utc_hour[Self::hour_index(hour)];
+        *slot = Some(slot.map_or(players, |previous| (previous * 3 + players).div_ceil(4)));
+    }
+
+    fn expect_busy(&self, now: i64) -> bool {
+        let hour = now.div_euclid(HOUR);
+        let current = self.utc_hour[Self::hour_index(hour)];
+        current.is_some_and(|current| current <= 3)
+            && [hour + 1, hour + 2].into_iter().any(|next| {
+                self.utc_hour[Self::hour_index(next)].is_some_and(|expected| expected >= 8)
+            })
+    }
+}
+
+#[derive(Clone, Default, Deserialize, Serialize)]
+#[serde(default)]
+pub(super) struct State {
+    pub(super) history: Usage,
+    pub(super) metadata: Usage,
+    pub(super) history_after: HashMap<u32, i64>,
+    pub(super) history_empty: HashSet<u32>,
+    pub(super) metadata_after: HashMap<u64, i64>,
+    pub(super) people: HashMap<u32, Person>,
+    pub(super) totals: Totals,
+    // One qualifying history page can reveal several matches; proven IDs survive restart.
+    pub(super) found: HashMap<u32, Vec<HistoryRow>>,
+    pub(super) latest_clock: i64,
+    pub(super) next_persona_at: i64,
+    pub(super) api_after: i64,
+    pub(super) api_seen: HashMap<u64, i64>,
+    pub(super) seen_duplicates: HashMap<u64, i64>,
+    pub(super) demand: Demand,
+}
+
+impl State {
+    pub(super) fn prune(&mut self, tasks: &[Task], now: i64) {
+        let players: HashSet<_> = tasks.iter().map(Task::account).collect();
+        // Keep cooldowns until their expiry even if a player toggles eligibility.
+        self.history_after.retain(|_, until| *until > now);
+        self.metadata_after.retain(|_, until| *until > now);
+        self.people.retain(|id, _| players.contains(id));
+        self.api_seen.retain(|_, seen| *seen > now - 7 * DAY);
+        self.seen_duplicates.retain(|_, seen| *seen > now - 7 * DAY);
+        self.history_empty.retain(|id| players.contains(id));
+        self.found.retain(|id, rows| {
+            rows.retain(|row| i64::from(row.start_time) > now - DAY);
+            !rows.is_empty() && players.contains(id)
+        });
+    }
+
+    pub(super) const fn usage(&self, kind: Operation) -> &Usage {
+        match kind {
+            Operation::History => &self.history,
+            Operation::Metadata => &self.metadata,
+        }
+    }
+
+    pub(super) const fn usage_mut(&mut self, kind: Operation) -> &mut Usage {
+        match kind {
+            Operation::History => &mut self.history,
+            Operation::Metadata => &mut self.metadata,
+        }
+    }
+
+    pub(super) fn charged(&mut self, candidate: &Candidate, now: i64) {
+        self.latest_clock = now;
+        let streamer = candidate.task.streamer;
+        let usage = self.usage_mut(candidate.kind());
+        usage.last_player = Some(candidate.task.account());
+        usage.streamer_streak = if streamer {
+            usage.streamer_streak.saturating_add(1)
+        } else {
+            0
+        };
+        if let Some(id) = candidate.match_id {
+            self.metadata_after.insert(id, now + HOUR);
+            if streamer {
+                self.totals.metadata_streamer += 1;
+            } else {
+                self.totals.metadata_regular += 1;
+            }
+        } else {
+            // If a response is lost the request remains charged and backing off.
+            self.history_after
+                .insert(candidate.task.account(), now + 6 * HOUR);
+            if streamer {
+                self.totals.history_streamer += 1;
+            } else {
+                self.totals.history_regular += 1;
+            }
+        }
+    }
+}
